# SpekNova Platform Environment Variables Example

# Supabase Configurations
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:password@db.your-supabase.supabase.co:5432/postgres

# AI Engines Config & API Keys
# LLM Provider Key (OpenAI / Gemini / Anthropic)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend and Backend endpoints
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
